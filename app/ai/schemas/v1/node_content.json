{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "node_content.v1.json",
  "type": "object",
  "required": ["original", "plain", "analogy", "sources"],
  "additionalProperties": false,
  "properties": {
    "original": {"type": "string", "minLength": 6},
    "plain": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "string", "minLength": 6}
    },
    "analogy": {"type": "string", "minLength": 6},
    "diagramSvg": {"type": ["string", "null"]},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "page", "excerpt"],
        "additionalProperties": false,
        "properties": {
          "type": {"enum": ["doc", "ai"]},
          "page": {"type": "integer", "minimum": 1},
          "excerpt": {"type": "string", "minLength": 4}
        }
      }
    }
  }
}
