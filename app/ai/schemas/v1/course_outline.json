{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "course_outline.v1.json",
  "type": "object",
  "required": ["title", "chapters"],
  "additionalProperties": false,
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "chapters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["title", "sections"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 120},
          "sections": {
            "type": "array",
            "minItems": 1,
            "maxItems": 40,
            "items": {
              "type": "object",
              "required": ["title", "refs"],
              "additionalProperties": false,
              "properties": {
                "title": {"type": "string", "minLength": 1, "maxLength": 120},
                "refs": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "required": ["sourceId", "pageStart", "pageEnd"],
                    "additionalProperties": false,
                    "properties": {
                      "sourceId": {"type": "string", "minLength": 1},
                      "pageStart": {"type": "integer", "minimum": 1},
                      "pageEnd": {"type": "integer", "minimum": 1}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
