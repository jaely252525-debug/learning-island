{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge_points.v1.json",
  "type": "object",
  "required": ["points"],
  "additionalProperties": false,
  "properties": {
    "points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["title", "definition", "type", "page", "excerpt"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string", "minLength": 2, "maxLength": 40},
          "definition": {"type": "string", "minLength": 6, "maxLength": 200},
          "type": {"enum": ["concept", "method", "process"]},
          "page": {"type": "integer", "minimum": 1},
          "excerpt": {"type": "string", "minLength": 4},
          "importanceHint": {"enum": ["high", "normal", "low"]}
        }
      }
    }
  }
}
