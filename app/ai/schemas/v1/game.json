{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game.v1.json",
  "type": "object",
  "required": ["template", "payload"],
  "additionalProperties": false,
  "properties": {
    "template": {"enum": ["match", "order", "scenario"]},
    "payload": {
      "type": "object",
      "required": ["q"],
      "additionalProperties": false,
      "properties": {
        "q": {"type": "string", "minLength": 4},
        "pairs": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "steps": {"type": "array", "minItems": 3, "maxItems": 6, "items": {"type": "string", "minLength": 2}},
        "options": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string", "minLength": 2}},
        "answerIndex": {"type": "integer", "minimum": 0, "maximum": 2},
        "explanation": {"type": "string", "minLength": 4}
      }
    }
  }
}
