# 复制成 .env 再改；密钥只留在后端环境变量里
DATABASE_URL=sqlite:///./data/xiaodao.db
DATA_DIR=./data
TOKEN_SECRET=change-me-to-a-random-string
MAX_FILE_MB=100
MAX_PAGES=500
ALLOWED_ORIGINS=*
RATE_LIMIT_PER_MINUTE=120
AUTO_WORKER=true
RENDER_DPI=150

# AI：mock 是离线假数据；接真模型改成 api 并填下面四项
AI_PROVIDER=mock
AI_BASE_URL=https://your-provider/v1
AI_API_KEY=
AI_MODEL=large-model
AI_MODEL_CHEAP=small-model
